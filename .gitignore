# Local-only generated data. The local tools produce these from private Codex stores, so they
# contain private session text: never stage or publish them.

# Corpora, ground truth, triggers and folded feedback
/jev/corpus.jsonl
/jev/truth.jsonl
/jev/triggers.jsonl
/jev/feedback-corpus.jsonl

# Scored outputs and human review artifacts
/jev/score*.json
/jev/review-set.md
/jev/REVIEW.md

# Public dataset: private intermediates, review and export artifacts
/jev/dataset/score*.json
/jev/dataset/review*.jsonl
/jev/dataset/review*.md
/jev/dataset/*.private.json
/jev/dataset/*.private.jsonl
/jev/dataset/.redaction-log.jsonl
/jev/dataset/export*.json

# Raw probe payload logs
/probe/logs/

# Backtesting sandbox: any local run output or cache accidentally written beside the source is
# private session data and must never be tracked. The sandbox itself writes only under the
# ignored .publication-audit/backtesting/ path.
/backtest/out/
/backtest/.jev-cache/

# Private publication-audit workspace: raw snapshots, source mappings, reviewer annotations,
# queues, caches and results for the backtesting sandbox. Never tracked, never published.
/.publication-audit/